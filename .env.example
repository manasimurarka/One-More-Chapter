DATABASE_URL="postgresql://APP_USER:APP_PASSWORD@POSTGRES_HOST:5432/one_more_chapter?sslmode=require"
# Paste the single current CA certificate from ClickHouse Cloud's PostgreSQL Connect screen.
# Literal \n sequences are supported for Vercel environment variables.
POSTGRES_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
CLICKHOUSE_URL="https://CLICKHOUSE_HOST:8443"
CLICKHOUSE_DATABASE="one_more_chapter"
CLICKHOUSE_USERNAME="APP_ANALYTICS_USER"
CLICKHOUSE_PASSWORD="REPLACE_ME"
OPENAI_API_KEY="REPLACE_ME"
OPENAI_MODEL="gpt-5-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TAGGING_MODEL="gpt-5-mini"
GOOGLE_BOOKS_API_KEY="REPLACE_ME"
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_VALUE"
PIN_LOOKUP_SECRET="REPLACE_WITH_A_LONG_RANDOM_VALUE"
